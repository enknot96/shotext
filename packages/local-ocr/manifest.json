{
  "manifest_version": 3,
  "name": "ShoText！- ショッテキ！",
  "version": "1.0.1",
  "description": "Select an area on screen and copy its text (OCR).",

  "permissions": ["activeTab", "offscreen", "notifications", "clipboardWrite", "scripting"],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },

  "action": {
    "default_popup": "src/popup/popup.html"
  },

  "commands": {
    "take-screenshot": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Select an area to copy text"
    }
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
